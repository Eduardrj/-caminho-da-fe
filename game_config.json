  "faith_system": {
    "description": "Atributo central que mede a relação do jogador com Deus",
    "faith_points": {
      "min": 0,
      "max": 1000,
      "starting_value": 400,
      "milestones": [
        { "threshold": 10, "reward": "desbloqueia oração de súplica" },
        { "threshold": 25, "reward": "desbloqueia intercessão por aliados" },
        { "threshold": 50, "reward": "desbloqueia cura por imposição de mãos" },
        { "threshold": 100, "reward": "acesso a milagres menores" },
        { "threshold": 250, "reward": "acesso a milagres maiores" },
        { "threshold": 500, "reward": "intervenção divina disponível" },
        { "threshold": 750, "reward": "visão profética" },
        { "threshold": 1000, "reward": "estado de retidão plena, todos os milagres" }
