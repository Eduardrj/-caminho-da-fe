  "prayer_system": {
    "description": "Sistema de oração com tipos distintos, cooldowns e respostas probabilísticas",
    "prayer_types": [
      {
        "id": "suplica",
        "name": "Súplica",
        "description": "Pede cura, proteção ou recurso imediato",
        "cooldown_seconds": 60,
        "requires_faith_min": 10,
        "biblical_reference": "Daniel 6",
        "implemented": true
      },
      {
        "id": "gratidao",
        "name": "Gratidão",
        "description": "Oferece graças logo após uma vitória",
        "cooldown_seconds": 30,
        "requires_faith_min": 5,
        "biblical_reference": "Êxodo 15 (Cântico de Moisés)",
        "must_trigger_after_combat_win": true,
        "combat_win_window_seconds": 15,
        "implemented": true
      },
      {
        "id": "arrependimento",
        "name": "Arrependimento",
        "description": "Restaura Fé perdida por pecado; requer um profeta próximo",
        "cooldown_seconds": 600,
        "requires_faith_min": 0,
        "biblical_reference": "Salmo 51 (Davi)",
        "requires_npc_prophet": true,
        "implemented": true
      },
      {
        "id": "intercessao",
        "name": "Intercessão",
        "description": "Ora por outro jogador ou NPC",
        "cooldown_seconds": 300,
        "requires_faith_min": 25,
        "biblical_reference": "Gênesis 18 (Abraão por Sodoma)",
        "implemented": false
      },
      {
        "id": "profetica",
        "name": "Profética",
        "description": "Recebe visão ou guia para a próxima quest",
        "cooldown_seconds": 3600,
        "requires_faith_min": 200,
        "biblical_reference": "Daniel 7-12 (Visões)",
        "implemented": false
      }
    ],
    "divine_response_roll": {
      "description": "Roll de resposta divina quando o jogador ora. O resultado final é limitado a 1-100.",
      "formula": "R = clamp( d100 + min(80, fe_atual / 25) + modificadores - penalidade_pecado , 1, 100 )",
      "response_tiers": [
        { "tier": "silencio", "min_roll": 1, "max_roll": 20, "effect": "oração não atendida, sem penalidade" },
        { "tier": "bonus_menor", "min_roll": 21, "max_roll": 50, "effect": "efeito leve" },
        { "tier": "bencao_parcial", "min_roll": 51, "max_roll": 80, "effect": "cura parcial e escudo de proteção" },
        { "tier": "milagre", "min_roll": 81, "max_roll": 95, "effect": "cura total e bênçãos maiores" },
        { "tier": "intervencao_divina", "min_roll": 96, "max_roll": 100, "effect": "milagre épico anunciado ao servidor" }
      ],
      "modifiers": {
        "praying_at_holy_place": 15,
        "praying_with_group_per_player": 10,
        "fasting_active": 30,
        "sin_debuff_active": -30
      }
    }
  },

